# Football history warehouse — copy to `.env` and adjust (never commit secrets).
# Load with your shell or tooling (`export $(grep -v '^#' .env | xargs)`).

# Required for DB access and Alembic. Examples:
#   postgresql+psycopg://user:password@localhost:5432/football_history
#   sqlite+pysqlite:///./var/football_history/local.db
FOOTBALL_WAREHOUSE_DATABASE_URL=

# Optional: disposable Postgres URL for tests/test_storage_transactional_path.py only.
# FOOTBALL_WAREHOUSE_TEST_POSTGRES_URL=postgresql+psycopg://user:pass@localhost:5432/warehouse_test

# Import CLI (see manual_games/README.md):
#   python -m football_history_warehouse.cli.import_espn --file ... --league-id ... --season-id ... --team-map-json '...'

# Optional: log SQL (dev only)
# FOOTBALL_WAREHOUSE_SQL_ECHO=1

# --- Play Caller: optional warehouse advisory (read-only context on Generate) ---
# Prefer session JSON keys warehouse_* on ``Game.session_metadata``; env overrides for dev.
# PLAYCALLER_WAREHOUSE_LEAGUE_ID=
# PLAYCALLER_WAREHOUSE_SEASON_ID=
# PLAYCALLER_WAREHOUSE_GAME_ID=
# PLAYCALLER_WAREHOUSE_COACHED_TEAM_ID=
# PLAYCALLER_WAREHOUSE_OPPONENT_TEAM_ID=
